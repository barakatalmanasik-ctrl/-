rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══════════════════════════════════════
       HELPER: isAdmin()
       Reads admins/{uid} to verify role
       Used for non-admins collection access
       ═══════════════════════════════════════ */
    function isAdmin() {
      return request.auth != null
             && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    /* ═══════════════════════════════════════
       ADMINS COLLECTION
       Schema: admins/{uid} = { role, email, createdAt, permissions }
       - Users can READ their own admin document (self-check)
       - Users can READ other admin docs only if they are admin (admin panel listing)
       - No self-escalation: unauthenticated users cannot write
       - Only existing admins can create/update other admin docs
       ═══════════════════════════════════════ */
    match /admins/{adminId} {
      /* Self-read: anyone authenticated can read their own doc */
      allow read: if request.auth != null
                  && request.auth.uid == adminId;

      /* Admin-read: admin can read other admin docs (for future multi-admin panel) */
      allow read: if request.auth != null
                  && request.auth.uid != adminId
                  && isAdmin();

      /* Create: only existing admins can create new admin docs */
      allow create: if request.auth != null
                    && isAdmin()
                    && request.resource.data.role is string
                    && request.resource.data.role in ['admin', 'editor', 'viewer'];

      /* Update: only existing admins can update */
      allow update: if request.auth != null
                    && isAdmin();

      /* Delete: only existing admins can delete other admin docs, cannot delete self */
      allow delete: if request.auth != null
                    && request.auth.uid != adminId
                    && isAdmin();
    }

    /* ═══════════════════════════════════════
       COMMENTS COLLECTION
       Schema: comments/{id} = { name, service, text, stars, status, approved, createdAt, ... }
       ═══════════════════════════════════════ */
    match /comments/{commentId} {
      /* Anyone authenticated can create a comment (pending by default) */
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['name', 'text', 'stars', 'status', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 10
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.stars is number
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.status == 'pending'
                    && request.resource.data.approved == false;

      /* Public: read only approved; Admin: read all */
      allow read: if resource.data.status == 'approved' || isAdmin();

      /* Admin only: update */
      allow update: if isAdmin();

      /* Admin only: delete */
      allow delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       IMAGES COLLECTION
       Schema: images/{id} = { name, url, storagePath, size, createdAt }
       Public read (needed for site display), admin write
       ═══════════════════════════════════════ */
    match /images/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       SETTINGS COLLECTION
       Schema: settings/{id} = { ... fields }
       Public read (company info), admin write
       ═══════════════════════════════════════ */
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══════════════════════════════════════
       SERVICES COLLECTION (future expansion)
       Public read, admin write
       ═══════════════════════════════════════ */
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       GALLERY COLLECTION
       Public read, admin write
       ═══════════════════════════════════════ */
    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       TRIPS COLLECTION
       Public read (active only), admin read/write all
       ═══════════════════════════════════════ */
    match /trips/{tripId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       OFFERS COLLECTION (future expansion)
       Public read, admin write
       ═══════════════════════════════════════ */
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       NEWS COLLECTION (future expansion)
       Public read, admin write
       ═══════════════════════════════════════ */
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       ADMIN_LOGS COLLECTION (future expansion)
       Admin read/write only
       ═══════════════════════════════════════ */
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}