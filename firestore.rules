rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Helper: check if requester is the admin */
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'admin@barakatalmanasik.com';
    }

    /* ═══════════════════════════════════════
       COMMENTS COLLECTION
       - Visitors can ADD comments only
       - Visitors can READ only approved comments
       - Admin can do everything
       ═══════════════════════════════════════ */
    match /comments/{commentId} {
      /* Anyone can create a comment (pending by default) */
      allow create: if request.resource.data.keys().hasAll(['name', 'text', 'stars', 'status', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 10
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.stars is number
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.status == 'pending'
                    && request.resource.data.approved == false;

      /* Visitors can only read approved comments; admin can read all */
      allow read: if resource.data.status == 'approved' || isAdmin();

      /* Only admin can update comments */
      allow update: if isAdmin();

      /* Only admin can delete comments */
      allow delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       IMAGES COLLECTION
       - Anyone can read (needed for site display)
       - Only admin can write
       ═══════════════════════════════════════ */
    match /images/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       SETTINGS COLLECTION
       - Public read for company data
       - Only admin can write
       ═══════════════════════════════════════ */
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══════════════════════════════════════
       ADMINS COLLECTION (future multi-admin)
       - Only admins can manage
       ═══════════════════════════════════════ */
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    /* ═══════════════════════════════════════
       SERVICES COLLECTION (future expansion)
       ═══════════════════════════════════════ */
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       OFFERS COLLECTION (future expansion)
       ═══════════════════════════════════════ */
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ═══════════════════════════════════════
       NEWS COLLECTION (future expansion)
       ═══════════════════════════════════════ */
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}