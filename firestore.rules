rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══════════════════════════════════════
       COMMENTS COLLECTION
       - Visitors can ADD comments only
       - Visitors can READ only approved comments
       - Admin can do everything
       ═══════════════════════════════════════ */
    match /comments/{commentId} {
      /* Anyone can create a comment (pending by default) */
      allow create: if request.resource.data.keys().hasAll(['name', 'text', 'stars', 'status', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 10
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.stars is number
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.status == 'pending'
                    && request.resource.data.approved == false;

      /* Visitors can only read approved comments */
      allow read: if resource.data.status == 'approved'
                  || request.auth != null
                  && request.auth.token.admin == true;

      /* Only admin can update comments */
      allow update: if request.auth != null
                    && request.auth.token.admin == true;

      /* Only admin can delete comments */
      allow delete: if request.auth != null
                    && request.auth.token.admin == true;
    }

    /* ═══════════════════════════════════════
       IMAGES COLLECTION
       - Only admin can read/write
       ═══════════════════════════════════════ */
    match /images/{imageId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                                    && request.auth.token.admin == true;
    }

    /* ═══════════════════════════════════════
       SETTINGS COLLECTION
       - Public read for company data
       - Only admin can write
       ═══════════════════════════════════════ */
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    /* ═══════════════════════════════════════
       ADMINS COLLECTION (for future multi-admin)
       - Only admins can manage
       ═══════════════════════════════════════ */
    match /admins/{adminId} {
      allow read, write: if request.auth != null
                         && request.auth.token.admin == true;
    }

    /* ═══════════════════════════════════════
       SERVICES COLLECTION (future expansion)
       - Public read, admin write
       ═══════════════════════════════════════ */
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                                    && request.auth.token.admin == true;
    }

    /* ═══════════════════════════════════════
       OFFERS COLLECTION (future expansion)
       - Public read, admin write
       ═══════════════════════════════════════ */
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                                    && request.auth.token.admin == true;
    }

    /* ═══════════════════════════════════════
       NEWS COLLECTION (future expansion)
       - Public read, admin write
       ═══════════════════════════════════════ */
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                                    && request.auth.token.admin == true;
    }
  }
}
